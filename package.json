{
  "name": "brightwater-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "worker": "node --env-file=.env.local --import tsx scripts/automation-worker.ts",
    "worker:once": "npm run worker -- --once"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
